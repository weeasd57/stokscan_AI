# Web Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key_here

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PYTHON_BACKEND_URL=http://localhost:8000

# External APIs
NEXT_PUBLIC_GNEWS_API_KEY=your_gnews_api_key_here

# Admin Security
ADMIN_SECRET_PASSWORD=your_secure_admin_password_here

# Service Role (Only for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
