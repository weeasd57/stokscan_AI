# Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Telegram Bot
ARTORO_AI_BOT=your_telegram_bot_token_here

# Webhooks & URLs
WEBHOOK_URL=https://your-webhook-url.com
WEB_ORIGIN=https://your-frontend-url.com

# Data Sources
EODHD_API_KEY=your_eodhd_api_key_here
TRADINGVIEW_DEFAULT_MARKET=EGX

# TradingView Settings
TRADINGVIEW_REQUEST_DELAY=1
TRADINGVIEW_BULK_CHUNK_SIZE=50

# WhatsApp Integration (Optional)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Telegram Relay (Optional)
TELEGRAM_RELAY_URL=https://your-telegram-relay.com

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Timeouts (Optional)
SUPABASE_CONNECT_TIMEOUT=5000
SUPABASE_POSTGREST_TIMEOUT=10000
SUPABASE_STORAGE_TIMEOUT=5000

# Cache Settings (Optional)
STOKSCANAI_DISABLE_JOBLIB_CACHE=false
STOKSCANAI_JOBLIB_CACHE_DIR=.cache/joblib

# Debug Settings (Optional)
DEBUG_SUPABASE_ERRORS=false
BT_DEBUG_ENV=false
