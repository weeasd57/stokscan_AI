# Enhanced Backtest System Configuration
# Copy relevant settings to your main .env file

# ============================================================================
# ENHANCED BACKTEST SYSTEM CONTROL
# ============================================================================

# Enable/disable enhanced backtest system
# Set to 'false' to use legacy system (NOT RECOMMENDED)
USE_ENHANCED_BACKTEST=true

# ============================================================================
# PORTFOLIO MANAGER SETTINGS
# (Only used when USE_ENHANCED_BACKTEST=true)
# ============================================================================

# Maximum percentage of portfolio for single position (0.10 = 10%)
BT_MAX_POSITION_PCT=0.10

# Maximum total portfolio exposure (0.50 = 50%)
BT_MAX_TOTAL_EXPOSURE=0.50

# Maximum number of concurrent positions
BT_MAX_CONCURRENT_POSITIONS=5

# Cash reserve percentage to keep (0.20 = 20%)
BT_RESERVE_CASH_PCT=0.20

# Commission rate per transaction (0.001 = 0.1%)
BT_COMMISSION_PCT=0.001

# ============================================================================
# CONSERVATIVE SETTINGS (for risk-averse users)
# ============================================================================
# BT_MAX_POSITION_PCT=0.05      # 5% max per position
# BT_MAX_TOTAL_EXPOSURE=0.30    # 30% max exposure
# BT_MAX_CONCURRENT_POSITIONS=3 # Max 3 positions
# BT_RESERVE_CASH_PCT=0.30      # 30% cash reserve

# ============================================================================
# AGGRESSIVE SETTINGS (for higher risk tolerance)
# ============================================================================
# BT_MAX_POSITION_PCT=0.15      # 15% max per position
# BT_MAX_TOTAL_EXPOSURE=0.70    # 70% max exposure
# BT_MAX_CONCURRENT_POSITIONS=8 # Max 8 positions
# BT_RESERVE_CASH_PCT=0.10      # 10% cash reserve

# ============================================================================
# DEBUGGING
# ============================================================================

# Enable debug output for backtest system
BT_DEBUG_ENV=0

# Log backtest configuration on startup
BT_LOG_CONFIG=1